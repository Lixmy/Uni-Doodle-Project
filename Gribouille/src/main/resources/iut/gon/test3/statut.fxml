<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<GridPane xmlns="http://javafx.com/javafx/17"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="iut.gon.test3.controleurs.StatutController"
          prefHeight="24.0" prefWidth="201.0">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" prefWidth="101.0" />
        <ColumnConstraints hgrow="SOMETIMES" prefWidth="115.0" />
        <ColumnConstraints hgrow="SOMETIMES" prefWidth="156.0" />
        <ColumnConstraints hgrow="SOMETIMES" prefWidth="124.0" />
        <ColumnConstraints hgrow="SOMETIMES" prefWidth="127.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    </rowConstraints>
    <children>
        <HBox prefHeight="30.0" prefWidth="192.0">
            <Label fx:id="ordonnee" text="X : 0" />
        </HBox>
        <HBox prefHeight="30.0" prefWidth="192.0" GridPane.columnIndex="1">
            <Label fx:id="abscisse" text="Y : 0" />
        </HBox>
        <HBox prefHeight="30.0" prefWidth="192.0" GridPane.columnIndex="2">
            <Label fx:id="epaisseur" text="Epaisseur : 3" />
        </HBox>
        <HBox prefHeight="30.0" prefWidth="192.0" GridPane.columnIndex="3">
            <Label fx:id="outil" text="Outil" />
        </HBox>
        <HBox prefHeight="30.0" prefWidth="192.0" GridPane.columnIndex="4">
            <Label fx:id="couleurLabel" text="Couleur" />
        </HBox>
    </children>
</GridPane>